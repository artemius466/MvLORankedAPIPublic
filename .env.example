# Copy this to .env and fill in real values (never commit .env itself - see
# .gitignore). Defaults for anything omitted live in src/config.js.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord bot (src/bot/) - separate from the OAuth app credentials above.
# Leave DISCORD_BOT_TOKEN blank to run without the bot entirely.
DISCORD_BOT_TOKEN=
# Optional: registers slash commands to this guild only (instant) instead of
# globally (up to an hour to propagate).
DISCORD_GUILD_ID=
# Comma-separated channel ids the live online/region stats embed is kept
# updated in. Leave blank to skip the stats embed even with the bot enabled.
DISCORD_STATS_CHANNEL_IDS=
DISCORD_STATS_REFRESH_SECONDS=30

# Site gate (frontend/js/gate.js) - requires having SITE_GATE_ROLE_ID in
# DISCORD_GUILD_ID above to load the site at all; public API routes like
# /api/online and /api/leaderboard are unaffected. Needs the bot (above) to
# check roles. Set SITE_GATE_ENABLED=false, or just leave SITE_GATE_ROLE_ID
# blank, to turn this off entirely without touching any code.
SITE_GATE_ENABLED=true
SITE_GATE_ROLE_ID=
# discord.gg invite shown on the "you don't have access" screen.
SITE_GATE_DISCORD_INVITE=

# Comma-separated Discord ids that get the admin panel (frontend/admin.html,
# /api/admin/*): it lists every user and match and can revert matches. Empty
# (or unset) disables the panel entirely.
ADMIN_DISCORD_IDS=

DISCORD_REDIRECT_URI=http://localhost:3000/api/callback
FRONTEND_URL=http://localhost:3000/
DATABASE_URL=postgres://mvlo:mvlo@127.0.0.1:5433/mvlo_ranked
REDIS_URL=redis://127.0.0.1:6380
CORS_ORIGINS=*
PROFILE_REFRESH_MINUTES=10

NODE_ENV=development

# Glicko-2 ratings (src/domain/glicko.js) - see docs/rating.md. All optional;
# these are the defaults. GLICKO_DEFAULT_RD is 200 rather than Glickman's 350
# on purpose, because this system rates one match per period rather than
# batching them.
GLICKO_TAU=0.5
GLICKO_DEFAULT_RD=200
GLICKO_DEFAULT_VOLATILITY=0.06
GLICKO_RATING_PERIOD_DAYS=7

# Rating decay for inactive players (src/domain/ratingDecay.js). Separate from
# the rd inflation above: this moves the rating itself, and has no floor.
# Set RATING_DECAY_PER_DAY=0 to turn decay off entirely.
RATING_DECAY_IDLE_DAYS=30
RATING_DECAY_PER_DAY=4
RATING_DECAY_SWEEP_HOURS=24

# How often the region/map activity snapshot is sampled into the daily totals
# the Discord bot's /stats averages come from (src/domain/activity.js, and see
# docs/stats.md). Storage is a fixed ~18 rows a day whatever this is set to.
# 0 stops collecting entirely.
ACTIVITY_SAMPLE_SECONDS=60

# Used by docker-compose.yml for the postgres container; change this for a
# real deployment (docker-compose.yml falls back to "mvlo" if unset).
POSTGRES_PASSWORD=mvlo

# Production (behind HTTPS) - see docs/https-deployment.md:
# DISCORD_REDIRECT_URI=https://your-domain.example/api/callback
# FRONTEND_URL=https://your-domain.example/
# NODE_ENV=production

# Photon Custom Authentication shared secret (src/routes/api.js).
# Photon Cloud sends this key/value pair when authenticating clients:
#   photonToken=<token>
# Configure this exact same token in the Photon Dashboard under
# Custom Authentication -> Key/Value pairs, or append ?photonToken=<token> to
# the Authentication URL.
PHOTON_TOKEN=
